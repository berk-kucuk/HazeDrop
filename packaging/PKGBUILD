# Maintainer: Berk Küçük <dev.berkkucukk@gmail.com>
pkgname=hazedrop
pkgver=1.3.0
pkgrel=1
pkgdesc="Anonymous encrypted file transfer over Tor — Haze Protocol v2"
arch=('x86_64' 'aarch64')
url="https://github.com/berk-kucuk/HazeDrop"
license=('GPL-3.0-only')
# The venv's .so files are prebuilt wheels (PyQt6, cryptography, ...), not
# something makepkg compiled — stripping/splitting debug info from them just
# floods the terminal with "no debugging symbols found" noise and produces a
# useless -debug package.
options=('!strip' '!debug')
depends=(
    'python'
    'tor'
    'libgl'
)
makedepends=('python-pip')
optdepends=(
    'xdg-utils: open download folder after transfer'
)
install="$pkgname.install"
# LOCAL BUILD: the source tarball is generated from the local working tree by
# ../build-pkg.sh (NOT fetched from GitHub). To publish to the AUR, restore the
# github archive::URL source and the real sha256sums.
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

_venvdir="/opt/$pkgname"

package() {
    cd "HazeDrop-$pkgver"

    # Create virtual environment at the real install path
    install -dm755 "$pkgdir$_venvdir"
    python -m venv "$pkgdir$_venvdir"

    # Install HazeDrop and all Python dependencies into the venv
    "$pkgdir$_venvdir/bin/pip" install \
        --quiet \
        --no-warn-script-location \
        .

    # Strip the fakeroot $pkgdir prefix from shebangs and venv config
    find "$pkgdir$_venvdir/bin" -type f \
        -exec sed -i "s|$pkgdir||g" {} +
    sed -i "s|$pkgdir||g" "$pkgdir$_venvdir/pyvenv.cfg"

    # .pyc files bake in the absolute source path they were compiled from
    # (i.e. $pkgdir), which makepkg's packaging-issues check then flags one
    # warning per file for. Drop them; Python recompiles on first import
    # against the real /opt/hazedrop path.
    find "$pkgdir$_venvdir" -type d -name __pycache__ -exec rm -rf {} +

    # Symlink launcher into /usr/bin
    install -dm755 "$pkgdir/usr/bin"
    ln -sf "$_venvdir/bin/hazedrop" "$pkgdir/usr/bin/hazedrop"

    # Desktop entry
    install -Dm644 hazedrop.desktop \
        "$pkgdir/usr/share/applications/hazedrop.desktop"

    # Application icon
    install -Dm644 hazedrop/assets/logo.png \
        "$pkgdir/usr/share/pixmaps/hazedrop.png"
}
