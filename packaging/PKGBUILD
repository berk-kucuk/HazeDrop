# Maintainer: Berk Küçük <dev.berkkucukk@gmail.com>
pkgname=hazedrop
pkgver=1.5.0
pkgrel=3
pkgdesc="Anonymous encrypted file transfer over Tor — Haze Protocol v2"
arch=('x86_64' 'aarch64')
url="https://github.com/berk-kucuk/HazeDrop"
license=('GPL-3.0-only')
# Python libraries (PyQt6, qasync, aiohttp, cryptography, argon2, stem, …)
# come from maze-python, the shared Maze venv at /opt/maze/venv. This package
# ships only its own source tree and runs it with that interpreter.
depends=(
    'maze-python'
    'tor'
)
optdepends=(
    'xdg-utils: open download folder after transfer'
)
install="$pkgname.install"
# LOCAL BUILD: the source tarball is generated from the local working tree by
# ../build-pkg.sh (NOT fetched from GitHub). To publish to the AUR, restore the
# github archive::URL source and the real sha256sums.
source=("$pkgname-$pkgver.tar.gz"
        "apparmor.$pkgname")
sha256sums=('SKIP'
            'SKIP')

_appdir="/opt/$pkgname"

package() {
    cd "HazeDrop-$pkgver"

    # The application as a plain directory tree, importable with /opt/hazedrop
    # on sys.path (assets resolve via __file__).
    install -dm755 "$pkgdir$_appdir"
    cp -r hazedrop "$pkgdir$_appdir/hazedrop"
    find "$pkgdir$_appdir" -type d -name __pycache__ -prune -exec rm -rf {} +

    # Launcher — the shared interpreter, this tree on the path.
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/hazedrop" <<'EOF'
#!/usr/bin/env bash
export PYTHONPATH="/opt/hazedrop${PYTHONPATH:+:$PYTHONPATH}"
exec /opt/maze/venv/bin/python3 -m hazedrop "$@"
EOF

    # Desktop entry
    install -Dm644 hazedrop.desktop \
        "$pkgdir/usr/share/applications/hazedrop.desktop"

    # Application icon
    install -Dm644 hazedrop/assets/logo.png \
        "$pkgdir/usr/share/pixmaps/hazedrop.png"

    # AppArmor profile, in complain mode (logs, never blocks) — see the file.
    install -Dm644 "$srcdir/apparmor.$pkgname" "$pkgdir/etc/apparmor.d/$pkgname"
}
