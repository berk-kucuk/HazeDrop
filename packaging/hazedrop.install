# Load (or reload) the AppArmor profile into the running kernel. Only when
# AppArmor is actually running: inside a chroot (installer, ISO build) or with
# AppArmor off, the profile is simply picked up by apparmor.service at boot.
_load_profile() {
    [ -r /sys/kernel/security/apparmor/profiles ] || return 0
    command -v apparmor_parser >/dev/null 2>&1 || return 0
    systemctl is-active --quiet apparmor.service 2>/dev/null || return 0
    apparmor_parser -r -W /etc/apparmor.d/hazedrop 2>/dev/null \
        || echo "  (!) could not load the AppArmor profile now; it loads at next boot."
}

# Unload it before the file disappears (apparmor_parser -R needs the file).
_unload_profile() {
    [ -r /sys/kernel/security/apparmor/profiles ] || return 0
    command -v apparmor_parser >/dev/null 2>&1 || return 0
    [ -f /etc/apparmor.d/hazedrop ] || return 0
    apparmor_parser -R /etc/apparmor.d/hazedrop >/dev/null 2>&1 || true
}

post_install() {
    _load_profile
    echo ""
    echo "  ◈  HazeDrop installed!"
    echo ""
    echo "     hazedrop          — Launch GUI"
    echo "     hazedrop --cli    — Interactive TUI"
    echo "     hazedrop send     — Send a file"
    echo "     hazedrop receive  — Receive a file"
    echo ""
    echo "  Installed to: /opt/hazedrop  (runs in the shared Maze Python environment, /opt/maze/venv)"
    echo ""
}

post_upgrade() {
    post_install
}

pre_remove() {
    _unload_profile
}
