# AppArmor profile for HazeDrop — shipped in COMPLAIN mode.
#
# HazeDrop accepts connections from the whole Tor network, so a bug in its
# network code is reachable by strangers. This profile describes what the app
# legitimately does; anything outside it is LOGGED (complain mode), not
# blocked, so no feature can break while the profile is being proven.
#
#   See what it would have blocked:  sudo maze-audit   (or: journalctl -k -g 'apparmor="ALLOWED"')
#   Enforce it once the log is clean: sudo aa-enforce /etc/apparmor.d/hazedrop
#   Local additions (kept across updates): /etc/apparmor.d/local/hazedrop
#
# The explicit deny rules are different in kind: they name places that are
# never legitimate for a file-transfer app (SSH/GPG keys, wallets, autostart,
# shell start-up files), so they are written to hold without exception — they
# are safe to enforce from day one, and are always audited.

abi <abi/4.0>,
include <tunables/global>

@{HAZEDROP_APP} = /opt/hazedrop
@{MAZE_VENV}    = /opt/maze/venv

profile hazedrop /usr/bin/hazedrop flags=(complain) {
  include <abstractions/base>
  include <abstractions/bash>
  include <abstractions/consoles>
  include <abstractions/python>
  include <abstractions/qt6>
  include <abstractions/kde>
  include <abstractions/fonts>
  include <abstractions/freedesktop.org>
  include <abstractions/X>
  include <abstractions/wayland>
  include <abstractions/dri-enumerate>
  include <abstractions/mesa>
  include <abstractions/opengl>
  include <abstractions/vulkan>
  include <abstractions/dbus-session-strict>
  include <abstractions/nameservice>
  include <abstractions/openssl>
  include <abstractions/ssl_certs>
  include <abstractions/user-tmp>
  include <abstractions/private-files-strict>

  # The launcher script, then the shared Maze interpreter.
  /usr/bin/hazedrop r,
  /usr/bin/bash ix,
  /usr/bin/env ix,
  /usr/bin/python3* ix,
  @{MAZE_VENV}/bin/python3* ix,
  @{MAZE_VENV}/{,**} r,
  @{MAZE_VENV}/**.so* mr,
  @{HAZEDROP_APP}/{,**} r,
  /usr/share/pixmaps/hazedrop.png r,
  @{PROC}/@{pid}/{stat,status,cmdline,mounts,fd/} r,
  @{sys}/devices/system/cpu/{,**} r,

  # Network: local SOCKS/control ports of its own tor, nothing else directly.
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,
  network unix stream,

  # Home: files to send are picked from anywhere in it, and the download
  # folder is the user's choice (~/Downloads by default), so the home directory
  # is readable and writable — minus the places below that no file-transfer app
  # has any business touching. What the profile really takes away is the rest
  # of the system: no writes outside home and /tmp, no running other programs
  # except its own tor and xdg-open.
  owner @{HOME}/ r,
  owner @{HOME}/** rwk,

  # Never legitimate. (private-files-strict above already
  # covers SSH/GPG keys, browser and mail profiles, KWallet, autostart and the
  # shell start-up files; these are the persistence spots it misses.)
  audit deny @{HOME}/.config/systemd/{,**} wl,
  audit deny @{HOME}/.config/plasma-workspace/{,**} wl,
  audit deny @{HOME}/.local/share/applications/{,**} wl,
  audit deny @{HOME}/.{xprofile,xinitrc,xsession,pam_environment} wl,
  audit deny @{HOME}/.password-store/{,**} mrwkl,
  audit deny @{HOME}/.local/share/keyrings/{,**} mrwkl,

  # Its own tor, in a child profile.
  /usr/bin/tor cx -> tor,

  # "Open folder" after a transfer: hand off to the desktop, unconfined.
  /usr/bin/xdg-open Ux,

  profile tor {
    include <abstractions/base>
    include <abstractions/nameservice>
    include <abstractions/openssl>

    /usr/bin/tor mr,
    /usr/share/tor/{,**} r,
    /etc/tor/{,**} r,
    @{PROC}/@{pid}/{stat,status,meminfo} r,
    @{PROC}/meminfo r,
    @{sys}/devices/system/cpu/{,**} r,

    network inet stream,
    network inet6 stream,
    network inet dgram,
    network inet6 dgram,
    network netlink raw,
    network unix stream,

    # stem writes the torrc to the temp dir; DataDirectory is mkdtemp().
    owner /tmp/torrc-* r,
    owner /tmp/hazedrop_tor_*/{,**} rwk,

    include if exists <local/hazedrop.tor>
  }

  include if exists <local/hazedrop>
}
